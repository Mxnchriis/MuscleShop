---
const { user, cartCount } = Astro.locals;
---
<nav>
  <a href="/produits">Produits</a>
  <a href="/panier">Panier (<span data-cart-count>{cartCount}</span>)</a>
  {user ? (
    <>
      {user.role === 'admin' && <a class="admin-link" href="/admin">Admin</a>}
      <a href="/compte/commandes">Mes commandes</a>
      <button class="link" id="logout" type="button">Déconnexion ({user.name})</button>
    </>
  ) : (
    <a href="/compte/connexion">Connexion</a>
  )}
</nav>

<script>
  document.getElementById('logout')?.addEventListener('click', async () => {
    await fetch('/api/auth/logout', { method: 'POST' });
    window.location.href = '/';
  });
</script>

<style>
  nav { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
  nav a { color: inherit; }
  .admin-link { padding: 0.15rem 0.6rem; border-radius: 999px; background: #1d1d1f; color: #fff; text-decoration: none; font-size: 0.875rem; }
</style>
