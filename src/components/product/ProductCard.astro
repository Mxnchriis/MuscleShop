---
import type { Product } from '../../types';
import { formatPrice } from '../../lib/format';
import { discountPercent, productImage } from '../../lib/product';
import AddToCartButton from '../islands/AddToCartButton.astro';

interface Props { product: Product }
const { product } = Astro.props;
const discount = discountPercent(product);
---
<article class="card">
  <a href={`/produits/${product.slug}`}>
    <div class="media">
      <img src={productImage(product)} alt={product.name} width="400" height="400" loading="lazy" />
      {discount && <span class="badge">-{discount} %</span>}
    </div>
    <h3>{product.name}</h3>
  </a>
  <p class="price">
    {formatPrice(product.price)}
    {discount && <s>{formatPrice(product.originalPrice!)}</s>}
  </p>
  <AddToCartButton productId={product.id} disabled={product.stock === 0} />
</article>

<style>
  .card { display: flex; flex-direction: column; gap: 0.5rem; padding: 0.75rem; border: 1px solid var(--color-border); border-radius: var(--radius); }
  .card a { color: inherit; text-decoration: none; }
  .media { position: relative; }
  .card img { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; border-radius: var(--radius); }
  .badge { position: absolute; top: 0.5rem; left: 0.5rem; padding: 0.15rem 0.5rem; border-radius: 999px; background: var(--color-primary); color: #fff; font-size: 0.8rem; font-weight: 700; }
  h3 { margin: 0.25rem 0 0; font-size: 1rem; }
  .price { margin: 0; font-weight: 700; margin-top: auto; }
  .price s { margin-left: 0.5rem; color: var(--color-muted); font-weight: 400; font-size: 0.875rem; }
</style>
