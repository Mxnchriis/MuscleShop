---
import { formatPrice } from '../../lib/format';

interface Props { total: number; showCheckout?: boolean }
const { total, showCheckout = true } = Astro.props;
---
<aside class="summary">
  <p>Total : <strong>{formatPrice(total)}</strong></p>
  {showCheckout && <a class="btn" href="/commande">Passer commande</a>}
</aside>

<style>
  .summary { display: flex; justify-content: flex-end; align-items: center; gap: 1rem; margin-top: 1rem; }
</style>
