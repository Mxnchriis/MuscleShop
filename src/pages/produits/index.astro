---
import ShopLayout from '../../layouts/ShopLayout.astro';
import ProductGrid from '../../components/product/ProductGrid.astro';
import { createApi } from '../../lib/api';
import { productSorts } from '../../server/validators/products';

// Filtres transmis tels quels à l'API, qui les valide (?q=, ?sort=, ?promo=true)
const params = Astro.url.searchParams;
const q = params.get('q') ?? undefined;
const sort = productSorts.find((value) => value === params.get('sort')); // tri inconnu : ignoré
const promo = params.get('promo') ?? undefined;
const api = createApi(Astro.request);

const res = await api.api.products.$get({ query: { q, promo, sort } });
if (!res.ok) return new Response('Recherche invalide', { status: 400 });
const { items } = await res.json();

const titles: Record<string, string> = { 'best-sellers': 'Meilleures ventes', newest: 'Nouveautés' };
const title = promo === 'true' ? 'Promos du moment' : (sort && titles[sort]) || 'Catalogue';
---
<ShopLayout title={title}>
  <h1>{title}</h1>
  <form method="get">
    <input type="search" name="q" value={q} placeholder="Rechercher un produit" />
    <button class="btn" type="submit">Rechercher</button>
  </form>
  {items.length > 0 ? <ProductGrid products={items} /> : <p>Aucun produit trouvé.</p>}
</ShopLayout>

<style>
  form { display: flex; gap: 0.5rem; margin-bottom: 1.5rem; }
  form input { flex: 1; max-width: 24rem; }
</style>
