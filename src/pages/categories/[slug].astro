---
import ShopLayout from '../../layouts/ShopLayout.astro';
import ProductGrid from '../../components/product/ProductGrid.astro';
import { createApi } from '../../lib/api';

const slug = Astro.params.slug!;
const api = createApi(Astro.request);

const res = await api.api.categories[':slug'].$get({ param: { slug } });
if (!res.ok) return new Response('Catégorie introuvable', { status: 404 });
const category = await res.json();
---
<ShopLayout title={category.name}>
  <h1>{category.name}</h1>
  <ProductGrid products={category.products} />
</ShopLayout>
