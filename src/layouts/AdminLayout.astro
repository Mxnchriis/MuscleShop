---
import BaseLayout from './BaseLayout.astro';

interface Props { title: string; subtitle?: string }
const { title, subtitle } = Astro.props;
const { user } = Astro.locals;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const links = [
  { href: '/admin', label: 'Tableau de bord', icon: '▦' },
  { href: '/admin/stocks', label: 'Stocks', icon: '▤' },
  { href: '/admin/commandes', label: 'Commandes', icon: '☰' },
  { href: '/admin/performance', label: 'Performance', icon: '◔' },
];
---
<BaseLayout title={`${title} · Admin`}>
  <div class="admin">
    <aside class="sidebar">
      <a class="brand" href="/admin">MuscleShop <span>Admin</span></a>
      <nav aria-label="Administration">
        {links.map((link) => (
          <a href={link.href} aria-current={path === link.href ? 'page' : undefined}>
            <span aria-hidden="true">{link.icon}</span>{link.label}
          </a>
        ))}
      </nav>
      <div class="sidebar-footer">
        <span>{user?.name}</span>
        <a href="/">← Retour à la boutique</a>
      </div>
    </aside>
    <main class="admin-main">
      <header class="admin-header">
        <h1>{title}</h1>
        {subtitle && <p>{subtitle}</p>}
      </header>
      <slot />
    </main>
  </div>
</BaseLayout>

<style>
  .admin { display: grid; grid-template-columns: 15rem 1fr; min-height: 100vh; background: var(--page); }
  .sidebar { display: flex; flex-direction: column; gap: 1.5rem; padding: 1.25rem 1rem; background: #1d1d1f; color: #f0efec; position: sticky; top: 0; height: 100vh; }
  .brand { color: #fff; font-weight: 700; font-size: 1.1rem; text-decoration: none; }
  .brand span { color: var(--color-primary); }
  nav { display: flex; flex-direction: column; gap: 0.25rem; }
  nav a { display: flex; gap: 0.75rem; padding: 0.6rem 0.75rem; border-radius: var(--radius); color: #c7c7cc; text-decoration: none; }
  nav a:hover { background: #2c2c2e; color: #fff; }
  nav a[aria-current='page'] { background: #2c2c2e; color: #fff; box-shadow: inset 3px 0 0 var(--color-primary); }
  .sidebar-footer { margin-top: auto; display: flex; flex-direction: column; gap: 0.5rem; font-size: 0.875rem; color: #c7c7cc; }
  .sidebar-footer a { color: #f0efec; }
  .admin-main { padding: 1.5rem 2rem 3rem; min-width: 0; }
  .admin-header { margin-bottom: 1.5rem; }
  .admin-header h1 { margin: 0; }
  .admin-header p { margin: 0.25rem 0 0; color: var(--ink-2); }

  @media (max-width: 800px) {
    .admin { grid-template-columns: 1fr; }
    .sidebar { position: static; height: auto; flex-direction: row; flex-wrap: wrap; align-items: center; gap: 0.75rem; }
    nav { flex-direction: row; flex-wrap: wrap; }
    .sidebar-footer { margin-top: 0; flex-direction: row; }
    .admin-main { padding: 1rem; }
  }
</style>

<style is:global>
  /* Jetons de l'espace admin : encre, grille, séries (palette validée), statuts */
  .admin {
    --page: #f6f6f4;
    --card: #ffffff;
    --ink: #0b0b0b;
    --ink-2: #52514e;
    --muted: #898781;
    --grid: #e1e0d9;
    --axis: #c3c2b7;
    --border: rgba(11, 11, 11, 0.1);
    --series-1: #2a78d6;
    --series-2: #eb6834;
    --series-3: #1baf7a;
    --good: #0ca30c;
    --warning: #fab219;
    --serious: #ec835a;
    --critical: #d03b3b;
    color: var(--ink);
  }

  .admin main { max-width: none; margin: 0; }
  .admin h2 { font-size: 1.1rem; margin: 0 0 0.75rem; }

  /* Cartes */
  .admin .card { background: var(--card); border: 1px solid var(--border); border-radius: calc(var(--radius) * 1.5); padding: 1rem 1.25rem; min-width: 0; }
  .admin .card-header { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; margin-bottom: 0.75rem; }
  .admin .card-header h2 { margin: 0; }
  .admin .card-header p, .admin .hint { margin: 0; color: var(--muted); font-size: 0.85rem; }
  .admin .grid-2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr)); gap: 1rem; margin-bottom: 1rem; }
  .admin .stack { display: flex; flex-direction: column; gap: 1rem; }

  /* Indicateurs (stat tiles) */
  .admin .tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr)); gap: 1rem; margin-bottom: 1rem; }
  .admin .tile { background: var(--card); border: 1px solid var(--border); border-radius: calc(var(--radius) * 1.5); padding: 0.9rem 1rem; }
  .admin .tile-label { color: var(--ink-2); font-size: 0.85rem; }
  .admin .tile-value { font-size: 1.6rem; font-weight: 650; margin-top: 0.25rem; }
  .admin .tile-hint { color: var(--muted); font-size: 0.8rem; margin-top: 0.15rem; }

  /* Tableaux */
  .admin .table-scroll { overflow-x: auto; }
  .admin table.data { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  .admin table.data th { text-align: left; font-weight: 600; color: var(--ink-2); font-size: 0.8rem; padding: 0.5rem; border-bottom: 1px solid var(--axis); white-space: nowrap; }
  .admin table.data td { padding: 0.5rem; border-bottom: 1px solid var(--grid); vertical-align: middle; }
  .admin table.data .num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .admin table.data .muted { color: var(--muted); }
  .admin code { font-size: 0.85em; background: #f0efec; padding: 0.1rem 0.3rem; border-radius: 4px; }

  /* Statuts : toujours icône + libellé, jamais la couleur seule */
  .admin .status { display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.85rem; white-space: nowrap; }
  .admin .status::before { content: ''; width: 0.55rem; height: 0.55rem; border-radius: 50%; background: var(--status-color, var(--muted)); }
  .admin .status-good { --status-color: var(--good); }
  .admin .status-warning { --status-color: var(--warning); }
  .admin .status-serious { --status-color: var(--serious); }
  .admin .status-critical { --status-color: var(--critical); }
  .admin .status-neutral { --status-color: var(--axis); }

  /* Filtres : une rangée au-dessus du contenu */
  .admin .filters { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; margin-bottom: 1rem; }
  .admin .filters select, .admin .filters input { padding: 0.45rem 0.6rem; border: 1px solid var(--border); border-radius: var(--radius); font: inherit; background: var(--card); }
  .admin .pill { padding: 0.35rem 0.75rem; border-radius: 999px; border: 1px solid var(--border); color: var(--ink-2); text-decoration: none; font-size: 0.875rem; background: var(--card); }
  .admin .pill[aria-current='true'] { background: var(--ink); color: #fff; border-color: var(--ink); }
  .admin .btn-small { padding: 0.35rem 0.7rem; font-size: 0.85rem; }

  /* Graphiques (src/lib/charts.ts) */
  .chart { position: relative; min-height: 220px; }
  .chart-plot { position: relative; }
  .chart svg { display: block; overflow: visible; }
  .chart-grid { stroke: var(--grid); stroke-width: 1; }
  .chart-axis { stroke: var(--axis); stroke-width: 1; }
  .chart-tick { fill: var(--muted); font-size: 11px; font-variant-numeric: tabular-nums; }
  .chart-dot { stroke: var(--card); }
  .chart-crosshair { stroke: var(--axis); stroke-width: 1; }
  .chart-hit { fill: transparent; outline: none; }
  .chart-hit:focus-visible { fill: rgba(11, 11, 11, 0.04); }
  .chart-tooltip { position: absolute; z-index: 2; pointer-events: none; min-width: 9rem; padding: 0.5rem 0.65rem; background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08); font-size: 0.8rem; }
  .chart-tooltip-title { color: var(--ink-2); margin-bottom: 0.25rem; }
  .chart-tooltip-row { display: flex; align-items: center; gap: 0.4rem; }
  .chart-tooltip-row span:last-child { color: var(--ink-2); }
  .chart-key { display: inline-block; width: 0.7rem; height: 0.7rem; border-radius: 2px; flex: none; }
  .chart-tooltip .chart-key, .chart-key-line { height: 2px; width: 0.9rem; border-radius: 1px; }
  .chart-legend { display: flex; flex-wrap: wrap; gap: 1rem; margin-bottom: 0.5rem; font-size: 0.85rem; color: var(--ink-2); }
  .chart-legend-item { display: inline-flex; align-items: center; gap: 0.4rem; }
  .chart-data { margin-top: 0.5rem; font-size: 0.8rem; color: var(--ink-2); }
  .chart-data summary { cursor: pointer; }
  .chart-data table { border-collapse: collapse; margin-top: 0.5rem; }
  .chart-data th, .chart-data td { padding: 0.2rem 0.75rem 0.2rem 0; text-align: left; font-variant-numeric: tabular-nums; }
</style>
